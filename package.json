{
  "name": "tacobell-kiosk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite --host --mode development --port 5373 --strictPort",
    "staging": "vite --mode staging",
    "start": "vite",
    "build": "tsc -b && vite build",
    "buildStaging": "tsc -b && vite build --mode staging",
    "build-major": "node check-version.mjs major && tsc -b && vite build",
    "build-minor": "node check-version.mjs minor && tsc -b && vite build",
    "build-patch": "node check-version.mjs patch && tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "guardrails": "node scripts/guardrails.mjs",
    "guardrails:strict": "node scripts/guardrails.mjs --strict",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "check-deps": "node scripts/check-dependencies.mjs",
    "check-bundle-size": "node scripts/check-bundle-size.mjs",
    "type-check": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "validate": "yarn lint && yarn type-check && yarn guardrails && yarn depcruise && yarn check-deps && yarn test"
  },
  "dependencies": {
    "@cx-sdk/catalog": "link:../posistKiosk-cx-sdk/packages/catalog",
    "@cx-sdk/core": "link:../posistKiosk-cx-sdk/packages/core",
    "@cx-sdk/devices": "link:../posistKiosk-cx-sdk/packages/devices",
    "@cx-sdk/ordering": "link:../posistKiosk-cx-sdk/packages/ordering",
    "@cx-sdk/payments": "link:../posistKiosk-cx-sdk/packages/payments",
    "@reduxjs/toolkit": "^2.12.0",
    "classnames": "^2.5.1",
    "dayjs": "^1.11.19",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "firebase": "^12.19.0",
    "framer-motion": "^13.4.4",
    "i18next": "^26.4.2",
    "lodash": "^4.17.21",
    "posthog-js": "^1.434.13",
    "react": "^19.3.0",
    "react-cookie": "^8.0.1",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "react-idle-timer": "^5.7.3",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.4",
    "redux-persist": "^6.0.0",
    "redux-persist-transform-filter": "^0.0.22",
    "reselect": "^5.1.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.5.2",
    "@types/lodash": "^4.17.10",
    "@types/node": "^22",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "dependency-cruiser": "^18.4.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.3.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2",
    "workbox-window": "^7.3.0"
  }
}
