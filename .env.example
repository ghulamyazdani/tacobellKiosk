# Copy to .env.development / .env.staging / .env.production and fill in.
# NEVER commit real values — .env.* is gitignored by design.
VITE_API_ENDPOINT=
# FCM remote brand updates (P9e) stay OFF unless ALL FIVE below are set AND
# Chrome pre-grants notifications to the kiosk origin (enterprise policy
# NotificationsAllowedForUrls). The kiosk never prompts for permission.
# Values are inlined into the built JS (a Firebase web config and the VAPID
# PUBLIC key are public by design); still never commit them.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
# Not read by the kiosk (part of the Firebase console snippet; may stay blank).
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=
# PostHog kill switch: analytics only initialize when this is exactly "production"
VITE_POST_HOG_TYPE=
VITE_ZIPY_CODE=
